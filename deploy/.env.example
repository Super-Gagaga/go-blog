# ==================== Docker Compose 环境变量模板 ====================
# 使用方法:
#   1. 复制本文件为 .env:
#        Copy-Item deploy/.env.example deploy/.env
#   2. 部署前修改下面的密码与 JWT 密钥。
#
# 说明:
#   - .env 已被 .gitignore 忽略, 请勿将真实密钥提交到版本库。
#   - 这些变量会被 deploy/docker-compose.yml 以 ${VAR:-default} 方式读取。

# 宿主机端口映射 (如本地已占用 3306, 可改 MYSQL_PORT 为 3307)
APP_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL 初始化账号
MYSQL_ROOT_PASSWORD=your-root-password   # TODO: 改成真实 root 密码
MYSQL_DATABASE=go_blog
MYSQL_USER=go_blog
MYSQL_PASSWORD=your-password             # TODO: 改成真实密码

# JWT 密钥 (务必改成随机长字符串)
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
